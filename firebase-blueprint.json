{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna yang terautentikasi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        },
        "updatedAt": {
          "type": "string"
        },
        "familyId": {
          "type": ["string", "null"],
          "maxLength": 128
        }
      },
      "required": ["id", "email"]
    },
    "UserAppState": {
      "title": "UserAppState",
      "description": "Data profil anak, jadwal vaksin, dan catatan imunisasi pengguna",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128
        },
        "schemaVersion": {
          "type": "number"
        },
        "activeProfileId": {
          "type": "string",
          "maxLength": 128
        },
        "profiles": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["ownerId", "schemaVersion", "profiles"]
    },
    "FinanceTransaction": {
      "title": "FinanceTransaction",
      "description": "Dokumen transaksi pemasukan atau pengeluaran keuangan keluarga",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 64 },
        "walletId": { "type": "string", "maxLength": 64 },
        "date": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "type", "amount", "categoryId", "date", "createdAt", "updatedAt"]
    },
    "FinanceConfig": {
      "title": "FinanceConfig",
      "description": "Konfigurasi kategori kustom, anggaran bulanan, dompet, dan opsi integrasi keuangan",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "schemaVersion": { "type": "number" },
        "customCategories": { "type": "array" },
        "budgets": { "type": "object" },
        "includeVaccineCosts": { "type": "boolean" },
        "wallets": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerId", "schemaVersion", "customCategories", "budgets", "includeVaccineCosts"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Dokumen target tabungan dan progres keuangan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "targetAmount", "currentAmount"]
    },
    "RecurringRule": {
      "title": "RecurringRule",
      "description": "Aturan transaksi berulang otomatis secara periodik",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 64 },
        "walletId": { "type": "string", "maxLength": 64 },
        "frequency": { "type": "string" },
        "active": { "type": "boolean" },
        "startDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "amount", "categoryId", "walletId", "frequency"]
    }
    "Family": {
      "title": "Family",
      "description": "Dokumen profil keluarga",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "schemaVersion": { "type": "number" }
      },
      "required": ["id", "name", "ownerId", "createdAt", "updatedAt", "schemaVersion"]
    },
    "Member": {
      "title": "Member",
      "description": "Dokumen keanggotaan keluarga",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "familyId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "relation": { "type": "string" },
        "role": { "type": "string" },
        "isOwner": { "type": "boolean" },
        "joinedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "familyId", "displayName", "relation", "role", "isOwner", "joinedAt", "updatedAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Undangan bergabung keluarga",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 128 },
        "familyId": { "type": "string", "maxLength": 128 },
        "familyName": { "type": "string", "maxLength": 80 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "relation": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "used": { "type": "boolean" }
      },
      "required": ["code", "familyId", "familyName", "createdBy", "relation", "role", "createdAt", "expiresAt", "used"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "Pointer keanggotaan pengguna",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "familyId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "familyId", "createdAt"]
    },
    "FamilyFinanceTransaction": {
      "title": "FamilyFinanceTransaction",
      "description": "Transaksi keuangan keluarga",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "familyId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 64 },
        "walletId": { "type": "string", "maxLength": 64 },
        "date": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "familyId", "type", "amount", "categoryId", "date", "createdAt", "updatedAt", "createdBy", "updatedBy"]
    },
    "FamilyFinanceConfig": {
      "title": "FamilyFinanceConfig",
      "description": "Konfigurasi keuangan keluarga",
      "type": "object",
      "properties": {
        "familyId": { "type": "string", "maxLength": 128 },
        "schemaVersion": { "type": "number" },
        "customCategories": { "type": "array" },
        "budgets": { "type": "object" },
        "includeVaccineCosts": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["familyId", "schemaVersion", "customCategories", "budgets", "includeVaccineCosts", "updatedAt", "updatedBy"]
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dokumen profil akun pengguna"
    },
    "/users/{userId}/appData/{docId}": {
      "schema": "UserAppState",
      "description": "Dokumen penyimpanan cloud untuk profil anak dan jadwal vaksinasi"
    },
    "/users/{userId}/financeTransactions/{txId}": {
      "schema": "FinanceTransaction",
      "description": "Dokumen transaksi pemasukan dan pengeluaran keuangan"
    },
    "/users/{userId}/financeConfig/{docId}": {
      "schema": "FinanceConfig",
      "description": "Dokumen konfigurasi keuangan keluarga"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "Dokumen target tabungan pengguna"
    },
    "/users/{userId}/recurringRules/{ruleId}": {
      "schema": "RecurringRule",
      "description": "Dokumen aturan transaksi berulang"
    },
    "/families/{familyId}": {
      "schema": "Family",
      "description": "Dokumen profil keluarga"
    },
    "/families/{familyId}/members/{uid}": {
      "schema": "Member",
      "description": "Dokumen keanggotaan keluarga"
    },
    "/invites/{code}": {
      "schema": "Invite",
      "description": "Undangan bergabung keluarga"
    },
    "/users/{userId}/membership/current": {
      "schema": "UserMembership",
      "description": "Pointer keanggotaan keluarga pengguna"
    },
    "/families/{familyId}/financeTransactions/{txId}": {
      "schema": "FamilyFinanceTransaction",
      "description": "Transaksi keuangan keluarga"
    },
    "/families/{familyId}/financeConfig/main": {
      "schema": "FamilyFinanceConfig",
      "description": "Konfigurasi keuangan keluarga"
    },


  }
}


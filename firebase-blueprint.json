{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna yang terautentikasi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["id", "email"]
    },
    "UserAppState": {
      "title": "UserAppState",
      "description": "Data profil anak, jadwal vaksin, dan catatan imunisasi pengguna",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128
        },
        "schemaVersion": {
          "type": "number"
        },
        "activeProfileId": {
          "type": "string",
          "maxLength": 128
        },
        "profiles": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["ownerId", "schemaVersion", "profiles"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dokumen profil akun pengguna"
    },
    "/users/{userId}/appData/{docId}": {
      "schema": "UserAppState",
      "description": "Dokumen penyimpanan cloud untuk profil anak dan jadwal vaksinasi"
    }
  }
}

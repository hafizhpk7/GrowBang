rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // PRIVATE MODE SWITCH. true  = only the allow-listed account(s) can touch data (current).
    //                      false = any signed-in account can (public mode).
    function isPrivateMode() {
      return false;
    }
    function isAllowedAccount() {
      return request.auth.token.email is string
        && (request.auth.token.email.lower() in ['keluargapuyoeci@growbang.app', 'kelpuci@growbang.app']
            || request.auth.token.email.lower().matches('.*@' + 'growbang.app$'));
    }
    function isSignedIn() {
      return request.auth != null && (!isPrivateMode() || isAllowedAccount());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'updatedAt', 'familyId'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128))
        && (!('familyId' in data) || data.familyId == null || (data.familyId is string && data.familyId.size() <= 128));
    }

    function isValidUserAppState(data) {
      return data.keys().hasAll(['ownerId', 'schemaVersion', 'profiles'])
        && data.keys().hasOnly(['ownerId', 'schemaVersion', 'activeProfileId', 'profiles', 'paymentMode', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.schemaVersion is number
        && data.profiles is list && data.profiles.size() <= 100
        && (!('activeProfileId' in data) || (data.activeProfileId is string && data.activeProfileId.size() <= 128))
        && (!('paymentMode' in data) || (data.paymentMode in ['HYBRID', 'FULL_PRIVATE', 'FULL_BPJS']))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    function isValidFinanceTx(data) {
      return data.keys().hasAll(['id', 'ownerId', 'type', 'amount', 'categoryId', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'type', 'amount', 'categoryId', 'date', 'note', 'createdAt', 'updatedAt', 'walletId', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerId == request.auth.uid
        && data.type in ['income', 'expense']
        && data.amount is int && data.amount > 0 && data.amount <= 1000000000000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && (!('walletId' in data) || (data.walletId is string && data.walletId.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidFinanceConfig(data) {
      return data.keys().hasAll(['ownerId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts'])
        && data.keys().hasOnly(['ownerId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts', 'wallets', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.schemaVersion is number
        && data.customCategories is list && data.customCategories.size() <= 100
        && data.budgets is map && data.budgets.size() <= 200
        && data.includeVaccineCosts is bool
        && (!('wallets' in data) || (data.wallets is map && data.wallets.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll(['id', 'name', 'targetAmount', 'currentAmount'])
        && data.keys().hasOnly(['id', 'name', 'targetAmount', 'currentAmount', 'deadline', 'createdAt', 'updatedAt', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.targetAmount is int && data.targetAmount > 0 && data.targetAmount <= 1000000000000
        && data.currentAmount is int && data.currentAmount >= 0 && data.currentAmount <= 1000000000000
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidRecurringRule(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'categoryId', 'walletId', 'frequency'])
        && data.keys().hasOnly(['id', 'name', 'type', 'amount', 'categoryId', 'walletId', 'frequency', 'active', 'startDate', 'dayOfMonth', 'dayOfWeek', 'lastGeneratedThrough', 'createdAt', 'updatedAt', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.type in ['income', 'expense']
        && data.amount is int && data.amount > 0 && data.amount <= 1000000000000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && data.walletId is string && data.walletId.size() > 0 && data.walletId.size() <= 64
        && data.frequency in ['daily', 'weekly', 'monthly']
        && (!('active' in data) || data.active is bool)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 64))
        && (!('dayOfMonth' in data) || (data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31))
        && (!('dayOfWeek' in data) || (data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6))
        && (!('lastGeneratedThrough' in data) || (data.lastGeneratedThrough is string && data.lastGeneratedThrough.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    // Test connection path (used by getDocFromServer healthcheck)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User state and immunization records subcollection
      match /appData/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidUserAppState(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) 
          && incoming().ownerId == existing().ownerId 
          && isValidUserAppState(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /financeTransactions/{txId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(txId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(txId)
          && isValidFinanceTx(incoming()) && incoming().id == txId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(txId)
          && isValidFinanceTx(incoming()) && incoming().id == txId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(txId);
      }

      match /financeConfig/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'main';
        allow list: if false;
        allow create, update: if isOwner(userId) && isValidId(userId) && docId == 'main'
          && isValidFinanceConfig(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && docId == 'main';
      }

      match /savingsGoals/{goalId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(goalId) && isValidSavingsGoal(incoming()) && incoming().id == goalId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(goalId);
      }

      match /recurringRules/{ruleId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(ruleId) && isValidRecurringRule(incoming()) && incoming().id == ruleId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(ruleId);
      }
    }
    // Family Management
    match /families/{familyId} {
      allow get: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
      // Only admins can create or manage family
      allow create: if isSignedIn();
      allow update: if isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
      
      match /members/{uid} {
        allow get: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
        allow create: if isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isSignedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin');
      }

      match /financeConfig/{docId} {
        allow get: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && docId == 'main';
        allow list: if false;
        allow create, update: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && docId == 'main';
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin' && docId == 'main';
      }

      match /financeTransactions/{txId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
        allow create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
      }

      match /savingsGoals/{goalId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(goalId);
        allow create, update: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(goalId) && isValidSavingsGoal(incoming()) && incoming().id == goalId;
        allow delete: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(goalId);
      }

      match /recurringRules/{ruleId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(ruleId);
        allow create, update: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(ruleId) && isValidRecurringRule(incoming()) && incoming().id == ruleId;
        allow delete: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) && isValidId(ruleId);
      }

      match /babies/{babyId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
        allow write: if isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
      }
    }

    match /invites/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/families/$(incoming().fid)/members/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/families/$(existing().fid)/members/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
